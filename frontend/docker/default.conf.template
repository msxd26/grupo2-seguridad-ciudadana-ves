# Tu Vecino · Nginx: sirve la app compilada y redirige /api al backend.
# Plantilla: la imagen oficial reemplaza ${SITIO_SEGURO} y ${REDIRIGIR_HTTPS} al iniciar
# (ver 05-sitio-seguro.envsh). Las variables de Nginx ($host, $scheme…) no se tocan.
#
# HTTPS es obligatorio para las notificaciones y el GPS en el navegador. Con SITIO_SEGURO
# (ej. 34-176-116-202.sslip.io) se usa un certificado válido de Let's Encrypt; sin él,
# uno autofirmado (red local).

# http → https solo para la web y solo si ya hay certificado válido (REDIRIGIR_HTTPS=1).
map $scheme $redirigir_https {
    http    ${REDIRIGIR_HTTPS};
    default 0;
}

server {
    listen 80 default_server;
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/tuvecino.crt;
    ssl_certificate_key /etc/nginx/certs/tuvecino.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root  /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    client_max_body_size 32k;

    # Validación de Let's Encrypt (siempre por http, nunca se redirige)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    # Tiempo real (WebSocket): actualiza la conexión HTTP a WS y la mantiene abierta.
    # No se redirige: la app Android se conecta por http a la IP.
    location = /api/ws {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # API REST (tampoco se redirige, por la app Android)
    location /api/ {
        proxy_pass http://backend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Archivos con hash en el nombre: caché larga
    location /assets/ {
        if ($redirigir_https) { return 301 https://${SITIO_SEGURO}$request_uri; }
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier ruta de React devuelve index.html (sin caché).
    # Quien entra por http (o por la IP) va a la dirección segura.
    location / {
        if ($redirigir_https) { return 301 https://${SITIO_SEGURO}$request_uri; }
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
