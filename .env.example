# Configuración de Docker Compose (copiar a .env y completar)

# IP de esta PC en la red local (ipconfig) — se usa para el certificado HTTPS
PUBLIC_HOST=192.168.1.20

# Puertos publicados en la red local
HTTP_PORT=80
HTTPS_PORT=443

# MySQL
MYSQL_DATABASE=seguridad_ves
MYSQL_USER=ves_app
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# Sesiones: valor largo y aleatorio (mínimo 32 caracteres)
JWT_SECRET=

# Primer administrador
ADMIN_NOMBRE=Administrador VES
ADMIN_EMAIL=admin@alertaves.pe
ADMIN_PASSWORD=

# Opcional: IA conversacional (https://console.groq.com)
GROQ_API_KEY=

# Cargar reportes DEMO la primera vez (true/false)
SEED_DEMO=true
